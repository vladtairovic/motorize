# Banco (PostgreSQL 16 + PostGIS)
DATABASE_URL=postgres://motorize:motorize@localhost:5432/motorize

PORT=3333
# Origens liberadas no CORS (app do entregador e painel municipal)
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# Segredos JWT — troque em produção (mín. 32 caracteres)
JWT_ACCESS_SECRET=troque-este-segredo-de-acesso-com-32-chars-ou-mais
JWT_REFRESH_SECRET=troque-este-segredo-de-refresh-com-32-chars-ou-mais

# Validade da credencial em meses
CREDENCIAL_VALIDADE_MESES=12

# Meta de adesão (público-alvo estimado)
META_ENTREGADORES=300
